@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dcatap: <http://data.europa.eu/r5r/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex: <https://example.org/> .

# Added to hvd.ttl for the HVD 3.0.0 API-presence constraint.
ex:distribution dcat:accessService ex:service .
ex:service a dcat:DataService ; dct:title "API"@en ;
  dct:license <https://creativecommons.org/licenses/by/4.0/> ;
  dcat:endpointURL ex:api ; dcat:servesDataset ex:dataset ;
  dcat:contactPoint ex:contact ; foaf:page ex:documentation ;
  dcatap:hvdCategory <http://data.europa.eu/bna/c_03ba8d92> ;
  dcatap:applicableLegislation <http://data.europa.eu/eli/reg_impl/2023/138/oj> .
ex:api a rdfs:Resource .
ex:documentation a foaf:Document .
ex:contact a vcard:Kind ; vcard:fn "Fixture contact" ; vcard:hasEmail <mailto:fixture@example.org> .
<mailto:fixture@example.org> a rdfs:Resource .
