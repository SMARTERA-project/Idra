# =============================================================================
# Idra master stack — environment template
# Copy to `.env` (same directory) and fill in real values. `.env` is git-ignored.
# This compose builds ALL services (db, keycloak, mqa, ngsi-broker, portal,
# orion), so this file must cover every service's variables.
# Values marked "change-me" are secrets and MUST be set per environment.
# =============================================================================

# --- MySQL (Idra DB) ---
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=idra_db

# --- Keycloak admin ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Canonical PUBLIC Keycloak URL (the one the browser uses). Pins the token issuer
# (iss) so a token minted via the browser and refreshed via the Idra BFF
# (keycloak:8080) validate against the SAME issuer. Without this the refresh
# fails with 400 invalid_grant "Invalid token issuer". Must match the origin in
# PORTAL_KEYCLOAK_BASE_URL. Include the /auth path: when KC_HOSTNAME is a full
# URL, that URL (path included) becomes the base for the generated frontend URLs,
# so the /auth segment must be here too — otherwise links drop /auth and 404.
KEYCLOAK_HOSTNAME_URL=http://localhost:8180/auth

# --- Keycloak DB (Postgres) ---
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=change-me
KC_DB_PASSWORD=change-me

# --- MQA: Mongo + SeaweedFS (S3) + Service Configuration ---
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=change-me
MONGO_INITDB_DATABASE=admin
# MQA MongoDB configuration (optional overrides)
# MQA_MONGO_HOST=mongodb-mqa:27020
# MQA_MONGO_DB_NAME=mqa
# MQA_MONGO_TIMEOUT_MS=5000

# SeaweedFS (S3-compatible object storage) configuration.
# The seaweedfs container in this stack exposes the S3 API on port 8333.
S3_ENDPOINT=seaweedfs:8333
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_ACTIVE=true
S3_SECURE=false
# Storage paths and limits (optional overrides)
# S3_BUCKET_NAME=public-data
# S3_PATH_PREFIX=Metadata quality validator/
# S3_MAX_VERSIONS=4
# S3_PART_SIZE_MB=10

# MQA service configuration
# MQA_PORT=8000
# MQA_CORS_ORIGINS=http://localhost:4200,http://localhost
# MQA_MAX_UPLOAD_BYTES=104857600  (100MB default)
# MQA_MAX_FETCH_BYTES=104857600   (100MB default)
# Comma-separated hostnames allowed for MQA server-side fetch (SSRF allowlist).
# MUST include the Idra host so MQA can pull catalogue dumps via file_url.
MQA_URL_ALLOWLIST=idra

# --- Idra backend: DB connection ---
IDRA_DB_HOST=jdbc:mysql://db:3306/idra_db?allowPublicKeyRetrieval=true&serverTimezone=UTC&useLegacyDatetimeCode=false&useEncoding=true&characterEncoding=UTF-8&useSSL=false
IDRA_DB_HOST_MIN=jdbc:mysql://db:3306
IDRA_DB_NAME=idra_db
IDRA_DB_USER=root
IDRA_DB_PASSWORD=change-me

# --- Idra backend: LOD / dump / Orion ---
IDRA_LOD_SERVER_URI=http://rdf4j:8080/rdf4j-server/repositories/
IDRA_LOD_SERVER_URI_QUERY=http://rdf4j:8080/rdf4j-workbench/repositories/Idra/query
IDRA_ORION_INTERNAL_API=http://localhost:8080/Idra/api/v1/client/executeOrionQuery
IDRA_ORION_MANAGER_URL=http://ngsi-broker:8082/
IDRA_ORION_CB_URL=http://orion-ld-SMARTERA-final:1026/

# --- Idra backend: automatic MQA analysis on federation ---
# Start an MQA analysis automatically when a catalogue is federated / re-synchronized.
IDRA_MQA_ENABLED=true
# MQA scoring service as reached by Idra inside the docker network
IDRA_MQA_URL=http://mqa-score:8000
# Idra base URL (incl. context path) as reached by the MQA container; used to build
# the catalogue dump file_url that MQA fetches for analysis.
IDRA_MQA_IDRA_BASEURL=http://idra:8080/Idra

# --- Idra backend: datalet ---
DATALET_ENABLED=true
DATALET_URL=https://your-domain.it/deep/deep-components/demo.html

# --- Idra backend: JVM + CORS allowlist ---
JAVA_OPTS=-Xms1024m -Xmx3g -Didra.cors.allowed.origins=http://mqa-score,http://rdf4j,http://deep,http://ngsi-broker,http://localhost,http://localhost:4200,https://dx-lab.eng.it

# --- Idra backend: Keycloak / OIDC ---
IDRA_AUTH_METHOD=KEYCLOAK
IDM_PROTOCOL=http
IDM_HOST=keycloak:8080/auth/realms/smartera/protocol/openid-connect
IDM_PATH_BASE=
IDM_CLIENT_ID=data-platform
IDM_CLIENT_SECRET=
IDM_REDIRECTURI=http://localhost:8080/Idra/api/v1/administration/login
IDM_LOGOUT_CALLBACK=http://localhost:4200
IDRA_SERVER_BASEURL=http://localhost:8080/
IDM_ADMIN_ROLE_NAME=IDRA_ADMIN

# --- NGSI-LD Broker Manager ---
NGSI_SERVER_DEBUG=false
NGSI_IDRA_BASE_PATH=http://idra:8080
NGSI_HOST_ORION=http://orion-ld-SMARTERA-final
NGSI_PORT_ORION=1026
# Context Broker hostnames exempt from the SSRF private-address check. The Orion
# broker runs INSIDE the docker network (private IP), so its host must be listed
# here or every CB operation fails with 500. Comma-separated; empty = none.
NGSI_CB_URL_ALLOWLIST=orion-ld-SMARTERA-final

# --- IdraPortal-ngx (frontend) ---
# Rendered into assets/env.js at container startup by 40-generate-env.sh.
# Empty values fall back to the localhost defaults shown here.
PORTAL_ENABLE_AUTHENTICATION=true
PORTAL_AUTHENTICATION_METHOD=keycloak
# Keycloak as reached by the BROWSER (host port mapping 8180->8080)
PORTAL_KEYCLOAK_BASE_URL=http://localhost:8180
PORTAL_KEYCLOAK_REALM=smartera
PORTAL_DASHBOARD_BASE_URL=http://localhost:4200
PORTAL_CLIENT_ID=data-platform
PORTAL_AUTH_PROFILE=oidc
# Idra backend as reached by the BROWSER
PORTAL_IDRA_BASE_URL=http://localhost:8080
PORTAL_ENABLE_DATALET=true
PORTAL_DATALET_BASE_URL=http://localhost:80/deep/deep-components/creator.html
# MQA service as reached by the BROWSER
PORTAL_MQA_BASE_URL=http://localhost:8000
# Idra as reached from INSIDE the docker network (used for MQA file_url submits)
PORTAL_IDRA_DOCKER_URL=http://idra:8080
PORTAL_LANGUAGES=en,de,fr,it,sp,gr,pt,lt
PORTAL_ORION_MANAGER_ENABLED=true
PORTAL_TRANSLATIONS_BASE_URL=https://raw.githubusercontent.com/OPSILab/IdraPortal-ngx-Translations
